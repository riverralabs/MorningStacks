---
type Props = {
  title?: string;
  pros: string[];
  cons: string[];
};

const { title, pros, cons } = Astro.props;
---

<section
  class="not-prose my-10 overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-ink-06)] bg-[var(--color-cream)]"
>
  {
    title && (
      <header class="border-b border-[var(--color-ink-06)] bg-[var(--color-cream-warm)] px-6 py-4">
        <h3 class="font-sans text-[18px] font-bold tracking-[-0.012em] text-[var(--color-ink)]">
          {title}
        </h3>
      </header>
    )
  }
  <div class="grid gap-0 sm:grid-cols-2">
    <div class="p-6 sm:border-r sm:border-[var(--color-ink-06)]">
      <p class="font-sans text-[13px] font-bold uppercase tracking-[0.14em] text-[var(--color-blue)]">
        Pros
      </p>
      <ul class="mt-3 space-y-2 font-serif text-[14px] leading-relaxed text-[var(--color-ink-85)]">
        {pros.map((p) => <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-ink-55)]">+</span><span>{p}</span></li>)}
      </ul>
    </div>
    <div class="border-t border-[var(--color-ink-06)] p-6 sm:border-l-0 sm:border-t-0">
      <p class="font-sans text-[13px] font-bold uppercase tracking-[0.14em] text-[var(--color-blue)]">
        Cons
      </p>
      <ul class="mt-3 space-y-2 font-serif text-[14px] leading-relaxed text-[var(--color-ink-85)]">
        {cons.map((c) => <li class="flex gap-2"><span aria-hidden="true" class="text-[var(--color-ink-55)]">-</span><span>{c}</span></li>)}
      </ul>
    </div>
  </div>
</section>
