---
import { getCollection } from 'astro:content';
import { SITE } from '~/lib/seo';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order,
);
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-[var(--color-ink)] text-[var(--color-cream)]">
  <div class="container-grid py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-4">
      <div class="md:col-span-2">
        <div class="font-serif text-[28px] font-medium tracking-[-0.025em]">
          MorningStacks<span class="text-[var(--color-blue)]">.</span>
        </div>
        <p
          class="mt-4 max-w-md font-serif italic text-[16px] leading-relaxed text-[rgba(250,244,232,0.85)]"
        >
          {SITE.tagline} Independent reviews. Published by Riverra Labs LLP.
        </p>
        <p class="mt-6 font-sans text-[13px] uppercase tracking-[0.14em] text-[rgba(250,244,232,0.7)]">
          Contact
        </p>
        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex min-h-11 items-center font-sans text-[14px] text-[var(--color-cream)] underline-offset-4 hover:underline"
        >
          {SITE.email}
        </a>
      </div>

      <div>
        <p class="font-sans text-[13px] font-medium uppercase tracking-[0.14em] text-[rgba(250,244,232,0.7)]">
          Sections
        </p>
        <ul class="mt-4 space-y-2 font-sans text-[14px]">
          {
            categories.map((c) => (
              <li>
                <a href={`/${c.data.slug}/`} class="inline-flex min-h-11 items-center hover:opacity-80">
                  {c.data.name}
                </a>
              </li>
            ))
          }
          <li><a href="/archive/" class="inline-flex min-h-11 items-center hover:opacity-80">Archive</a></li>
          <li><a href="/newsletter/" class="inline-flex min-h-11 items-center hover:opacity-80">Newsletter</a></li>
        </ul>
      </div>

      <div>
        <p class="font-sans text-[13px] font-medium uppercase tracking-[0.14em] text-[rgba(250,244,232,0.7)]">
          About
        </p>
        <ul class="mt-4 space-y-2 font-sans text-[14px]">
          <li><a href="/about/" class="inline-flex min-h-11 items-center hover:opacity-80">About</a></li>
          <li><a href="/methodology/" class="inline-flex min-h-11 items-center hover:opacity-80">How we test</a></li>
          <li><a href="/contact/" class="inline-flex min-h-11 items-center hover:opacity-80">Contact</a></li>
          <li><a href="/disclosure/" class="inline-flex min-h-11 items-center hover:opacity-80">Affiliate disclosure</a></li>
          <li><a href="/privacy/" class="inline-flex min-h-11 items-center hover:opacity-80">Privacy</a></li>
          <li><a href="/terms/" class="inline-flex min-h-11 items-center hover:opacity-80">Terms</a></li>
          <li><a href="/rss.xml" class="inline-flex min-h-11 items-center hover:opacity-80">RSS</a></li>
        </ul>
      </div>
    </div>

    <hr class="my-12 border-0 border-t border-[rgba(250,244,232,0.15)]" />

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-sans text-[13px] text-[rgba(250,244,232,0.85)]">
        © {year} Riverra Labs LLP. MorningStacks is the publication.
      </p>
      <p class="font-sans text-[13px] text-[rgba(250,244,232,0.85)]">
        Some links are affiliates. <a href="/disclosure/" class="underline underline-offset-4 hover:underline">Read the disclosure</a>.
      </p>
    </div>
  </div>
</footer>
