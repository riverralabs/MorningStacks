---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { articleHref } from '~/lib/publish';

type Props = {
  article: CollectionEntry<'articles'>;
  size?: 'sm' | 'md' | 'lg';
};

const { article, size = 'md' } = Astro.props;
const { data } = article;

const category = await getEntry(data.category);
const href = articleHref(category?.data.slug ?? 'productivity', article.id);

const titleClass = {
  sm: 'text-[18px] leading-[1.2] tracking-[-0.012em]',
  md: 'text-[22px] leading-[1.15] tracking-[-0.018em]',
  lg: 'text-[32px] leading-[1.05] tracking-[-0.025em]',
}[size];
---

<article class="group flex flex-col">
  {
    data.hero && (
      <a href={href} class="block overflow-hidden rounded-[var(--radius-xl)]">
        <Image
          src={data.hero}
          alt={data.heroAlt ?? data.title}
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 50vw, 100vw"
          loading="lazy"
          class="aspect-[16/10] w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.02]"
        />
      </a>
    )
  }
  <p class="mt-4 text-eyebrow">
    {data.eyebrow}
  </p>
  <h3 class:list={['mt-2 font-serif font-medium text-[var(--color-ink)]', titleClass]}>
    <a href={href} class="inline-flex min-h-11 items-center transition-opacity hover:opacity-80">{data.title}</a>
  </h3>
  <p class="mt-2 font-serif text-[15px] leading-relaxed text-[var(--color-ink-70)] line-clamp-3">
    {data.description}
  </p>
  <p class="mt-3 font-sans text-[12px] text-[var(--color-ink-55)]">
    {data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
  </p>
</article>
