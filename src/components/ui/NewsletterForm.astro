---
type Props = {
  variant?: 'inline' | 'card';
  source?: string;
  heading?: string;
  blurb?: string;
};

const {
  variant = 'card',
  source = 'site',
  heading = 'Get the stack, every Monday morning.',
  blurb = 'One short email. The tools we tested last week, what stood up, what fell apart. No fluff.',
} = Astro.props;

const isCard = variant === 'card';
---

<section
  id="newsletter"
  class:list={[
    'not-prose',
    isCard
      ? 'rounded-[var(--radius-xl)] bg-[var(--color-ink)] px-8 py-10 text-[var(--color-cream)] md:px-12 md:py-14'
      : 'border-y border-[var(--color-ink-10)] py-10',
  ]}
>
  <div class="mx-auto max-w-[var(--container-email)]">
    <p
      class:list={[
        'font-sans text-[11px] font-medium uppercase tracking-[0.16em]',
        isCard ? 'text-[rgba(250,244,232,0.55)]' : 'text-[var(--color-blue)]',
      ]}
    >
      The MorningStacks newsletter
    </p>
    <h2
      class:list={[
        'mt-3 font-sans text-[28px] font-bold leading-[1.1] tracking-[-0.022em]',
        isCard ? 'text-[var(--color-cream)]' : 'text-[var(--color-ink)]',
      ]}
    >
      {heading}
    </h2>
    <p
      class:list={[
        'mt-3 font-serif text-[16px] italic leading-relaxed',
        isCard ? 'text-[rgba(250,244,232,0.75)]' : 'text-[var(--color-ink-70)]',
      ]}
    >
      {blurb}
    </p>

    <form
      action="/api/subscribe"
      method="POST"
      class="mt-6 flex flex-col gap-3 sm:flex-row"
    >
      <input type="hidden" name="source" value={source} />
      <label class="sr-only" for={`email-${source}`}>Email address</label>
      <input
        id={`email-${source}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="your@work.email"
        class:list={[
          'w-full flex-1 rounded-md border px-4 py-3 font-sans text-[14px] outline-none focus:ring-2 focus:ring-[var(--color-blue)] focus:ring-offset-2',
          isCard
            ? 'border-[rgba(250,244,232,0.2)] bg-[rgba(250,244,232,0.05)] text-[var(--color-cream)] placeholder:text-[rgba(250,244,232,0.4)] focus:ring-offset-[var(--color-ink)]'
            : 'border-[var(--color-ink-15)] bg-[var(--color-cream)] text-[var(--color-ink)] placeholder:text-[var(--color-ink-40)] focus:ring-offset-[var(--color-page)]',
        ]}
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-md bg-[var(--color-blue)] px-6 py-3 font-sans text-[14px] font-semibold text-[var(--color-cream)] transition-transform duration-150 ease-out hover:-translate-y-[1px]"
      >
        Subscribe
      </button>
    </form>

    <p
      class:list={[
        'mt-4 font-sans text-[11px] uppercase tracking-[0.12em]',
        isCard ? 'text-[rgba(250,244,232,0.45)]' : 'text-[var(--color-ink-55)]',
      ]}
    >
      Free · No spam · Unsubscribe anytime
    </p>
  </div>
</section>
