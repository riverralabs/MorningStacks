---
type Tone = 'info' | 'good' | 'warn' | 'bad';

type Props = {
  tone?: Tone;
  title?: string;
};

const { title } = Astro.props;
---

<aside class="not-prose my-8 rounded-[var(--radius-lg)] border-l-[3px] border-[var(--color-blue)] bg-[var(--color-cream)] px-5 py-4">
  {
    title && (
      <p class="mb-2 font-sans text-[13px] font-bold uppercase tracking-[0.14em] text-[var(--color-blue)]">
        {title}
      </p>
    )
  }
  <div class="font-serif text-[15px] leading-relaxed text-[var(--color-ink-85)]">
    <slot />
  </div>
</aside>
