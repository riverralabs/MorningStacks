---
import { Image, getImage } from 'astro:assets';
import { getEntry, getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Disclosure from '~/components/ui/Disclosure.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
import ArticleCard from '~/components/ui/ArticleCard.astro';
import Stars from '~/components/ui/Stars.astro';
import TypeBadge from '~/components/ui/TypeBadge.astro';
import ProductCard from '~/components/ui/ProductCard.astro';
import ProsCons from '~/components/ui/ProsCons.astro';
import Verdict from '~/components/ui/Verdict.astro';
import Callout from '~/components/ui/Callout.astro';
import { articleSchema, reviewSchema, faqSchema, breadcrumbSchema } from '~/lib/schema';
import { ogImage, SITE, canonical } from '~/lib/seo';
import { articleSlug, articleVisibility, isPublished } from '~/lib/publish';
import { shouldShowDisclosure, typeLabel } from '~/lib/content-model';
import { authorByline } from '~/lib/byline';

type Props = {
  entry: CollectionEntry<'articles'>;
};

const { entry } = Astro.props;
const { data } = entry;
const body = typeof entry.body === 'string' ? entry.body : '';

const category = await getEntry(data.category);
if (!category) {
  throw new Error(`Missing category for article ${entry.id}`);
}

const author = await getEntry(data.author);
if (!author) {
  throw new Error(`Missing author for article ${entry.id}`);
}

const slug = articleSlug(entry.id);
const articleUrl = canonical(`/${category.data.slug}/${slug}/`);
const heroPath = `${category.data.slug}/${slug}`;
const visibility = articleVisibility(data);
const noindex = visibility !== 'published';

const allArticles = await getCollection('articles', ({ data: item }) => isPublished(item));
const fallbackRelated = allArticles
  .filter((a) => a.id !== entry.id && a.data.category.id === data.category.id)
  .slice(0, 3);

const relatedEntries = data.related.length
  ? await Promise.all(data.related.map((ref) => getEntry(ref)))
  : fallbackRelated;
const related = relatedEntries.filter((r): r is CollectionEntry<'articles'> => Boolean(r) && isPublished(r.data));

const productEntries = (
  await Promise.all(data.products.map((ref) => getEntry(ref)))
).filter((p): p is CollectionEntry<'products'> => Boolean(p));

const isReview = data.type === 'review';
const isRoundup = data.type === 'roundup';
const isBriefing = data.type === 'briefing';
const reviewedProduct = isReview ? productEntries[0] ?? null : null;
const showDisclosure = shouldShowDisclosure({ products: data.products, body });
const bodyHasProductCard = /<ProductCard\b/.test(body);
const bodyHasProsCons = /<ProsCons\b/.test(body);
const bodyHasVerdict = /<Verdict\b/.test(body);
const showLayoutProductCards = isReview && productEntries.length > 0 && !bodyHasProductCard;
const showLayoutProsCons = isReview && productEntries[0] && !bodyHasProsCons;
const showLayoutVerdict = isReview && (data.rating || productEntries[0]) && !bodyHasVerdict;
const lastTested = data.lastTested ?? productEntries[0]?.data.lastTested;
const testMethod = data.testMethod;
const ourPick = data.ourPick ?? productEntries[0]?.data.ourVerdict;

const customOg = data.og
  ? await getImage({ src: data.og, width: 1200, height: 630, format: 'png' })
  : null;
const ogUrl = customOg?.src
  ? new URL(customOg.src, SITE.url).toString()
  : ogImage(heroPath);

const ld: object[] = [
  isReview && reviewedProduct
    ? reviewSchema({
        url: articleUrl,
        title: data.title,
        description: data.description,
        datePublished: data.date,
        dateModified: data.updated ?? undefined,
        image: ogUrl,
        productName: reviewedProduct.data.name,
        productCategory: category.data.name,
        rating: data.rating ?? reviewedProduct.data.rating,
      })
    : articleSchema({
        url: articleUrl,
        title: data.title,
        description: data.description,
        datePublished: data.date,
        dateModified: data.updated ?? undefined,
        image: ogUrl,
        section: category.data.name,
      }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: category.data.name, url: `${SITE.url}/${category.data.slug}/` },
    { name: data.title, url: articleUrl },
  ]),
];
const faq = faqSchema(data.faq);
if (faq) ld.push(faq);

const datePub = data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const dateUpd = data.updated?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const lastTestedLabel = lastTested?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title={data.title}
  ogTitle={data.ogTitle}
  description={data.description}
  ogSlug={heroPath}
  ogImageUrl={ogUrl}
  type="article"
  publishedTime={data.date.toISOString()}
  modifiedTime={data.updated?.toISOString()}
  jsonLd={ld}
  noindex={noindex}
>
  <article class="pb-16 pt-10">
    <div class="container-article">
      <nav aria-label="Breadcrumb" class="font-sans text-[12px] text-[var(--color-ink-55)]">
        <a href="/" class="inline-flex min-h-11 items-center hover:opacity-75 focus-visible:opacity-100">Home</a>
        <span aria-hidden="true"> · </span>
        <a href={`/${category.data.slug}/`} class="inline-flex min-h-11 items-center hover:opacity-75">
          {category.data.name}
        </a>
      </nav>

      <header class="mt-4">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <TypeBadge type={data.type} />
          <span aria-hidden="true" class="text-[var(--color-ink-25)]">·</span>
          <span class="text-eyebrow">{data.eyebrow}</span>
        </p>
        <h1
          class="mt-2 font-serif text-[42px] font-medium leading-[1.05] tracking-[-0.026em] text-[var(--color-ink)] sm:text-[46px]"
        >
          {data.title}
        </h1>
        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-[13px] text-[var(--color-ink-55)]">
          <span>{authorByline(author.data)}</span>
          <time datetime={data.date.toISOString()}>{datePub}</time>
          {
            data.updated && (
              <span>
                Updated <time datetime={data.updated.toISOString()}>{dateUpd}</time>
              </span>
            )
          }
          {
            isReview && (data.rating ?? reviewedProduct?.data.rating) && (
              <Stars rating={data.rating ?? reviewedProduct!.data.rating} />
            )
          }
        </p>
        {
          data.answer && (
            <p class="mt-4 font-serif text-[17px] leading-[1.7] text-[var(--color-ink)]">
              {data.answer}
            </p>
          )
        }
        {
          isReview && (lastTestedLabel || testMethod) && (
            <p class="mt-3 font-sans text-[13px] text-[var(--color-ink-55)]">
              {lastTestedLabel && (
                <span>
                  Last tested <time datetime={lastTested!.toISOString()}>{lastTestedLabel}</time>
                </span>
              )}
              {lastTestedLabel && testMethod && <span aria-hidden="true"> · </span>}
              {testMethod && <span>{testMethod}</span>}
            </p>
          )
        }
      </header>

      {
        data.hero && (
          <figure class="ms-figure ms-figure--hero mt-6">
            <Image
              src={data.hero}
              alt={data.heroAlt ?? data.title}
              widths={[640, 720, 960, 1280]}
              sizes="(min-width: 720px) 672px, 100vw"
              loading="eager"
              class="h-auto w-full"
            />
          </figure>
        )
      }
    </div>

    <div class="container-article mt-10">
      {showDisclosure && <Disclosure variant="banner" />}

      {
        isBriefing && (
          <Callout title="Not a product test">
            This is a sourced {typeLabel(data.type).toLowerCase()}, not a lived-with review.
          </Callout>
        )
      }

      {
        isRoundup && ourPick && (
          <aside class="not-prose mb-8 border-l-[3px] border-[var(--color-blue)] bg-[var(--color-cream)] px-5 py-4">
            <p class="font-sans text-[13px] font-bold uppercase tracking-[0.14em] text-[var(--color-blue)]">
              Our pick
            </p>
            <p class="mt-2 font-serif text-[16px] leading-relaxed text-[var(--color-ink-85)]">
              {ourPick}
            </p>
          </aside>
        )
      }

      {
        showLayoutProductCards &&
          productEntries.map((product) => <ProductCard product={product.id} />)
      }

      {
        showLayoutProsCons && productEntries[0] && (
          <ProsCons title={productEntries[0].data.name} pros={productEntries[0].data.pros} cons={productEntries[0].data.cons} />
        )
      }

      {
        showLayoutVerdict && (
          <Verdict>
            {productEntries[0]?.data.ourVerdict ?? `Rated ${data.rating} of 5.`}
          </Verdict>
        )
      }

      <div class="prose-ms">
        <slot />
      </div>

      {
        data.faq.length > 0 && (
          <section class="not-prose mt-16 border-t border-[var(--color-ink-10)] pt-10">
            <h2 class="font-serif text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-[var(--color-ink)]">
              Frequently asked
            </h2>
            <dl class="mt-6 space-y-6">
              {data.faq.map((faqEntry) => (
                <div>
                  <dt class="font-sans text-[16px] font-bold text-[var(--color-ink)]">{faqEntry.q}</dt>
                  <dd class="mt-2 font-serif text-[17px] leading-[1.7] text-[var(--color-ink-85)]">
                    {faqEntry.a}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        data.sources.length > 0 && (
          <section class="not-prose mt-16 border-t border-[var(--color-ink-10)] pt-10">
            <h2 class="font-serif text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-[var(--color-ink)]">
              Sources
            </h2>
            <ul class="mt-6 space-y-3 font-serif text-[17px] leading-[1.7] text-[var(--color-ink-85)]">
              {data.sources.map((source) => (
                <li>
                  {source.url ? (
                    <a href={source.url} class="underline underline-offset-2">
                      {source.title}
                    </a>
                  ) : (
                    source.title
                  )}
                  <span class="font-sans text-[13px] text-[var(--color-ink-55)]">
                    {' '}
                    Checked {source.checked.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <div class="container-article mt-16">
      <NewsletterForm variant="card" source={`article-${slug}`} />
    </div>

    {
      related.length > 0 && (
        <section class="container-grid mt-20">
          <h2 class="font-sans text-[20px] font-bold uppercase tracking-[0.04em] text-[var(--color-ink-55)]">
            Read next
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-10 md:grid-cols-3">
            {related.slice(0, 3).map((r) => (
              <ArticleCard article={r} size="sm" />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
