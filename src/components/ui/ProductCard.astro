---
import { getEntry } from 'astro:content';
import Stars from './Stars.astro';
import { withAffiliateVia } from '~/lib/affiliate';

type Props = {
  product: string;
};

const { product } = Astro.props;
const entry = await getEntry('products', product);
if (!entry) {
  throw new Error(`ProductCard: missing product "${product}"`);
}
const p = entry.data;
const href = withAffiliateVia(p.affiliateUrl);
const cleanHost = (() => {
  try {
    return new URL(p.affiliateUrl).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
})();
---

<article
  class="not-prose my-10 overflow-hidden rounded-[var(--radius-xl)] border border-[var(--color-ink-06)] bg-[var(--color-cream)]"
>
  <div class="grid gap-0 md:grid-cols-[1.4fr_1fr]">
    <div class="p-8">
      <p class="font-sans text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--color-blue)]">
        {p.vendor}
      </p>
      <h3 class="mt-2 font-sans text-[26px] font-bold tracking-[-0.02em] leading-[1.1] text-[var(--color-ink)]">
        {p.name}
      </h3>
      <p class="mt-3 font-serif text-[16px] italic leading-relaxed text-[var(--color-ink-70)]">
        {p.summary}
      </p>

      <div class="mt-5 flex items-center gap-4">
        {p.rating > 0 && <Stars rating={p.rating} />}
        <span class="font-sans text-[12px] text-[var(--color-ink-55)]">
          {p.price}
        </span>
      </div>

      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        <div>
          <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-good)]">
            What works
          </p>
          <ul class="mt-2 space-y-1 font-serif text-[14px] leading-relaxed text-[var(--color-ink-85)]">
            {p.pros.map((pro) => <li>· {pro}</li>)}
          </ul>
        </div>
        <div>
          <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-bad)]">
            What doesn't
          </p>
          <ul class="mt-2 space-y-1 font-serif text-[14px] leading-relaxed text-[var(--color-ink-85)]">
            {p.cons.map((con) => <li>· {con}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <aside
      class="flex flex-col justify-between gap-6 border-t border-[var(--color-ink-06)] bg-[var(--color-cream-warm)] p-8 md:border-l md:border-t-0"
    >
      <div>
        <p class="font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-blue)]">
          Our verdict
        </p>
        <p class="mt-3 font-serif text-[15px] leading-relaxed text-[var(--color-ink-85)]">
          {p.ourVerdict}
        </p>
      </div>
      <div>
        <a
          href={href}
          rel="sponsored noopener"
          target="_blank"
          class="inline-flex min-h-11 w-full items-center justify-center rounded-md bg-[var(--color-blue)] px-5 py-3 font-sans text-[14px] font-semibold text-[var(--color-cream)] transition-transform duration-150 hover:-translate-y-[1px] motion-reduce:hover:translate-y-0"
        >
          Try {p.name} →
        </a>
        <p class="mt-3 font-sans text-[11px] uppercase tracking-[0.12em] text-[var(--color-ink-55)]">
          {cleanHost} · last tested {p.lastTested.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
        </p>
      </div>
    </aside>
  </div>
</article>
