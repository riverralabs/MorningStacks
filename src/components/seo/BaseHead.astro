---
import '~/styles/tokens.css';
import { SITE, buildTitle, buildDescription, socialTitle, canonical, ogImage } from '~/lib/seo';
import { organizationSchema, websiteSchema } from '~/lib/schema';

type Props = {
  title?: string;
  ogTitle?: string;
  description?: string;
  ogSlug?: string;
  ogImageUrl?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
};

const {
  title,
  ogTitle,
  description,
  ogSlug,
  ogImageUrl,
  canonicalPath,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const finalTitle = buildTitle(title);
const finalOgTitle = socialTitle(ogTitle, title);
const finalDescription = buildDescription(description);
const finalCanonical = canonical(canonicalPath ?? Astro.url.pathname);
const finalOgImage = ogImageUrl ?? ogImage(ogSlug);

const orgJsonLd = JSON.stringify(organizationSchema());
const siteJsonLd = JSON.stringify(websiteSchema());
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#FAF4E8" />
<meta name="color-scheme" content="light" />

<title>{finalTitle}</title>
<meta name="description" content={finalDescription} />
<link rel="canonical" href={finalCanonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

<link rel="preload" as="font" type="font/woff2" href="/fonts/lora-latin.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />

<meta property="og:type" content={type} />
<meta property="og:title" content={finalOgTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={finalCanonical} />
<meta property="og:image" content={finalOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.defaultLocale} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:title" content={finalOgTitle} />
<meta name="twitter:description" content={finalDescription} />
<meta name="twitter:image" content={finalOgImage} />

<script is:inline type="application/ld+json" set:html={orgJsonLd} />
<script is:inline type="application/ld+json" set:html={siteJsonLd} />

<slot />
