---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
---

<BaseLayout
  title="The MorningStacks newsletter"
  description="One short email when we have something worth sending. Not a live email service yet. Write to hello@morningstacks.com."
  ogSlug="newsletter"
>
  <section class="container-grid py-20">
    <p class="text-eyebrow">
      The newsletter
    </p>
    <h1 class="mt-3 font-sans text-[56px] font-bold leading-[0.95] tracking-[-0.036em] text-[var(--color-ink)]">
      Monday morning,<br />in your inbox<span class="text-[var(--color-blue)]">.</span>
    </h1>
    <p class="mt-6 max-w-[640px] font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
      The tools we tested, what stood up, what fell apart. Short. No fluff. The list is not live yet.
    </p>

    <div class="mt-12 max-w-[640px]">
      <NewsletterForm variant="card" source="newsletter-page" heading="Subscribe" blurb="No live email service is connected. This opens a message to hello@morningstacks.com." />
    </div>
  </section>
</BaseLayout>
