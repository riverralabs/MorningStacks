---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search every review, roundup, and editorial we've published."
  ogSlug="search"
>
  <section class="container-article py-16">
    <p class="font-sans text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--color-blue)]">
      Search the archive
    </p>
    <h1 class="mt-3 font-sans text-[44px] font-bold leading-[1.05] tracking-[-0.026em] text-[var(--color-ink)]">
      Find a tool, a roundup, an opinion<span class="text-[var(--color-blue)]">.</span>
    </h1>
    <p class="mt-5 font-serif text-[18px] italic leading-relaxed text-[var(--color-ink-70)]">
      Built-time index. Runs in your browser. No tracking.
    </p>

    <div id="search" class="mt-10"></div>
  </section>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script type="module" is:inline>
    import('/pagefind/pagefind-ui.js').then(({ PagefindUI }) => {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        excerptLength: 32,
      });
    }).catch(() => {
      const el = document.getElementById('search');
      if (el) el.innerHTML = '<p style="font-family:Lora,serif;font-style:italic;color:rgba(28,25,22,.7)">Search index will appear after the next build.</p>';
    });
  </script>

  <style is:global>
    #search .pagefind-ui__search-input {
      font-family: var(--font-sans);
      border: 1px solid var(--color-ink-15);
      background: var(--color-cream);
      border-radius: 8px;
      padding: 12px 16px;
      font-size: 15px;
    }
    #search .pagefind-ui__search-input:focus {
      outline: 2px solid var(--color-blue);
      outline-offset: 2px;
    }
    #search .pagefind-ui__result-title a {
      font-family: var(--font-sans);
      color: var(--color-ink);
    }
    #search .pagefind-ui__result-excerpt {
      font-family: var(--font-serif);
      color: var(--color-ink-70);
    }
    #search mark {
      background: rgba(30, 58, 95, 0.15);
      color: inherit;
    }
  </style>
</BaseLayout>
