---
import Icon from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'tertiary' | 'icon';

type Props = {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  rel?: string;
  target?: string;
  ariaLabel?: string;
  arrow?: boolean;
  class?: string;
};

const {
  variant = 'primary',
  href,
  type = 'button',
  rel,
  target,
  ariaLabel,
  arrow = false,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center gap-2 font-sans text-[14px] font-semibold tracking-[-0.005em] transition-transform duration-150 ease-out hover:-translate-y-[1px] focus-visible:-translate-y-[1px] motion-reduce:hover:translate-y-0 motion-reduce:focus-visible:translate-y-0';

const variants: Record<Variant, string> = {
  primary:
    'rounded-md bg-[var(--color-blue)] px-5 py-3 text-[var(--color-cream)] hover:opacity-95',
  secondary:
    'rounded-md border border-[var(--color-ink)] bg-transparent px-5 py-3 text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-[var(--color-cream)]',
  tertiary:
    'px-1 text-[var(--color-blue)] underline underline-offset-4 hover:opacity-75 hover:translate-y-0 focus-visible:translate-y-0',
  icon: 'size-11 min-w-11 shrink-0 rounded-md border border-[var(--color-ink-15)] bg-[var(--color-cream)] px-0 text-[var(--color-ink)] hover:border-[var(--color-blue)] hover:text-[var(--color-blue)] hover:translate-y-0 focus-visible:translate-y-0',
};

const cls = [base, variants[variant], className];
---

{
  href ? (
    <a href={href} rel={rel} target={target} aria-label={ariaLabel} class:list={cls}>
      <slot />
      {arrow && <Icon name="arrow" size={16} />}
    </a>
  ) : (
    <button type={type} aria-label={ariaLabel} class:list={cls}>
      <slot />
      {arrow && <Icon name="arrow" size={16} />}
    </button>
  )
}
