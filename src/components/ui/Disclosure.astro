---
/* Top-of-review disclosure banner. Plain language, FTC 16 CFR Part 255 aligned.
 * Clicking links to the full /disclosure page.
 */
type Props = {
  variant?: 'banner' | 'inline';
};

const { variant = 'banner' } = Astro.props;
---

{
  variant === 'banner' ? (
    <aside
      class="not-prose mb-8 border-l-[3px] border-[var(--color-blue)] bg-[var(--color-cream)] px-5 py-4 font-serif text-[14px] italic leading-relaxed text-[var(--color-ink-70)]"
    >
      <p class="m-0">
        <strong class="not-italic font-sans text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--color-blue)]">
          Disclosure&nbsp;·&nbsp;
        </strong>
        We earn a commission if you buy through some links on this page. It never
        changes the score, the verdict, or who gets reviewed.{' '}
        <a class="font-sans not-italic text-[var(--color-blue)] underline underline-offset-2 hover:opacity-75" href="/disclosure/">
          How this works.
        </a>
      </p>
    </aside>
  ) : (
    <p class="font-sans text-[12px] text-[var(--color-ink-55)]">
      Affiliate links may apply.{' '}
      <a class="text-[var(--color-blue)] underline underline-offset-2 hover:opacity-75" href="/disclosure/">
        Disclosure
      </a>
      .
    </p>
  )
}
