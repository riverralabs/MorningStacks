# Site
SITE_URL=https://morningstacks.com

# Newsletter. Provider deferred. Stub returns 200 and logs.
# When ready, set NEWSLETTER_PROVIDER to one of: stub | beehiiv | convertkit | buttondown
NEWSLETTER_PROVIDER=stub

# Beehiiv (https://developers.beehiiv.com)
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=

# ConvertKit / Kit (https://developers.kit.com)
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=

# Buttondown (https://docs.buttondown.email/api)
# BUTTONDOWN_API_KEY=

# Keystatic admin at /keystatic (git-backed, no extra CMS vendor).
# Local `pnpm dev` uses filesystem storage.
# On Vercel, set these so Jane can sign in with GitHub and commit to content/* branches:
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

