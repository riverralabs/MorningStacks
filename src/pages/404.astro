---
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="That URL didn't lead anywhere. Maybe one of these will."
  noindex={true}
>
  <section class="container-grid py-24">
    <p class="font-sans text-[13px] font-medium uppercase tracking-[0.14em] text-[var(--color-blue)]">
      404
    </p>
    <h1 class="mt-3 font-sans text-[56px] font-bold leading-[0.95] tracking-[-0.036em] text-[var(--color-ink)]">
      Nothing here<span class="text-[var(--color-blue)]">.</span>
    </h1>
    <p class="mt-6 max-w-[560px] font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
      The URL you followed didn't lead anywhere we publish. Probably a typo; possibly a piece we moved. Try the home page, or the section you were looking for.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex min-h-11 items-center justify-center rounded-md bg-[var(--color-blue)] px-6 py-3 font-sans text-[14px] font-semibold text-[var(--color-cream)] hover:-translate-y-[1px] motion-reduce:hover:translate-y-0 transition-transform"
      >
        Home
      </a>
      <a
        href="/archive/"
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-[var(--color-ink)] px-6 py-3 font-sans text-[14px] font-semibold text-[var(--color-ink)] hover:bg-[var(--color-ink)] hover:text-[var(--color-cream)] transition-colors"
      >
        Archive
      </a>
    </div>
  </section>
</BaseLayout>
