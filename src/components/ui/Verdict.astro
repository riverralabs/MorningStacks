---
type Props = {
  label?: string;
};

const { label = 'Verdict' } = Astro.props;
---

<p
  class="not-prose my-6 inline-flex items-baseline gap-2 rounded-[var(--radius-md)] border-l-[3px] border-[var(--color-blue)] bg-[var(--color-cream)] px-4 py-2 font-sans text-[14px] text-[var(--color-ink-85)]"
>
  <span class="font-bold uppercase tracking-[0.12em] text-[11px] text-[var(--color-blue)]">{label}</span>
  <span><slot /></span>
</p>
