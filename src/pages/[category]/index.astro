---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticleCard from '~/components/ui/ArticleCard.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
import { isPublished } from '~/lib/publish';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const articles = await getCollection('articles', ({ data }) => isPublished(data));
  return categories.map((category) => {
    const inCat = articles.filter((a) => a.data.category.id === category.id);
    return {
      params: { category: category.data.slug },
      props: { category, articles: inCat },
    };
  });
}

const { category, articles } = Astro.props;
const sorted = articles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title={`${category.data.name} · software for operators and founders`}
  description={category.data.description}
  ogSlug={`category-${category.data.slug}`}
>
  <header class="border-b border-[var(--color-ink-10)] bg-[var(--color-cream)]">
    <div class="container-grid py-16">
      <p class="text-eyebrow">
        Section
      </p>
      <h1
        class="mt-3 font-sans text-[56px] font-bold leading-[0.95] tracking-[-0.036em] text-[var(--color-ink)]"
      >
        {category.data.name}<span class="text-[var(--color-blue)]">.</span>
      </h1>
      <p class="mt-5 max-w-[640px] font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
        {category.data.description}
      </p>
    </div>
  </header>

  <section class="container-grid py-16">
    {
      sorted.length === 0 ? (
        <p class="font-serif italic text-[var(--color-ink-70)]">
          Nothing here yet. We test thoroughly. Subscribe below to know when the first piece lands.
        </p>
      ) : (
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
          {sorted.map((article) => (
            <ArticleCard article={article} size="md" />
          ))}
        </div>
      )
    }
  </section>

  <section class="container-grid pb-20">
    <NewsletterForm variant="card" source={`category-${category.data.slug}`} />
  </section>
</BaseLayout>
