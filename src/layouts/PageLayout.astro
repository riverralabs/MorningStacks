---
import BaseLayout from './BaseLayout.astro';

type Props = {
  title: string;
  description?: string;
  eyebrow?: string;
  ogSlug?: string;
};

const { title, description, eyebrow, ogSlug } = Astro.props;
---

<BaseLayout title={title} description={description} ogSlug={ogSlug}>
  <article class="container-article py-16">
    <header class="mb-10">
      {
        eyebrow && (
          <p class="font-sans text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--color-blue)]">
            {eyebrow}
          </p>
        )
      }
      <h1
        class="mt-3 font-sans text-[44px] font-bold leading-[1.05] tracking-[-0.026em] text-[var(--color-ink)] sm:text-[52px]"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-5 font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
            {description}
          </p>
        )
      }
    </header>

    <div class="prose-ms">
      <slot />
    </div>
  </article>
</BaseLayout>
