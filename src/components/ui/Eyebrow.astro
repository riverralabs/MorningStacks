---
type Props = {
  href?: string;
  class?: string;
};

const { href, class: className = '' } = Astro.props;
const base =
  'font-sans text-[13px] font-medium uppercase tracking-[0.14em] text-[var(--color-blue)]';
---

{
  href ? (
    <a href={href} class:list={[base, 'hover:opacity-75', className]}>
      <slot />
    </a>
  ) : (
    <span class:list={[base, className]}>
      <slot />
    </span>
  )
}
