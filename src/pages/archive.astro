---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
import ArticleListItem from '~/components/ui/ArticleListItem.astro';
import { articleHref, isPublished } from '~/lib/publish';

const published = await getCollection('articles', ({ data }) => isPublished(data));
const sorted = published.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rows = await Promise.all(
  sorted.map(async (article) => {
    const category = await getEntry(article.data.category);
    return {
      article,
      href: articleHref(category?.data.slug ?? 'productivity', article.id),
    };
  }),
);
---

<BaseLayout
  title="Archive"
  description="Every published MorningStacks piece, newest first. Drafts and templates stay off this list."
  ogSlug="archive"
>
  <header class="border-b border-[var(--color-ink-10)] bg-[var(--color-cream)]">
    <div class="container-grid py-16">
      <p class="text-eyebrow">Archive</p>
      <h1 class="mt-3 font-sans text-[56px] font-bold leading-[0.95] tracking-[-0.036em] text-[var(--color-ink)]">
        All writing<span class="text-[var(--color-blue)]">.</span>
      </h1>
      <p class="mt-5 max-w-[640px] font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
        Published pieces only. Drafts and templates stay off this list.
      </p>
    </div>
  </header>

  <section class="container-grid py-16">
    {
      rows.length === 0 ? (
        <p class="max-w-[560px] font-serif italic text-[var(--color-ink-70)]">
          Nothing published yet. Subscribe below for new briefings and comparisons.
        </p>
      ) : (
        <ul>
          {rows.map(({ article, href }) => (
            <ArticleListItem article={article} href={href} />
          ))}
        </ul>
      )
    }
  </section>

  <section class="container-grid pb-20">
    <NewsletterForm variant="card" source="archive" />
  </section>
</BaseLayout>
