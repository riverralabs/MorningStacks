---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import { mdxComponents } from '~/components/mdx/components';
import { articleSlug, isBuildable } from '~/lib/publish';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => isBuildable(data));
  return Promise.all(
    articles.map(async (entry) => {
      const cat = await getEntry(entry.data.category);
      return {
        params: {
          category: cat?.data.slug ?? 'productivity',
          slug: articleSlug(entry.id),
        },
        props: { entry },
      };
    }),
  );
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout entry={entry}>
  <Content components={mdxComponents} />
</ArticleLayout>
