---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
import { articleHref, isPublished } from '~/lib/publish';
import { authorByline } from '~/lib/byline';

const all = await getCollection('articles', ({ data }) => isPublished(data));
const sorted = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.find((a) => a.data.featured) ?? sorted[0];
const rest = sorted.filter((a) => a.id !== featured?.id);

const featuredCategory = featured ? await getEntry(featured.data.category) : null;
const featuredAuthor = featured ? await getEntry(featured.data.author) : null;
const featuredHref = featured
  ? articleHref(featuredCategory?.data.slug ?? 'productivity', featured.id)
  : '#';

const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);

const restRows = await Promise.all(
  rest.map(async (article) => {
    const category = await getEntry(article.data.category);
    const author = await getEntry(article.data.author);
    return {
      article,
      href: articleHref(category?.data.slug ?? 'productivity', article.id),
      byline: author ? authorByline(author.data) : '',
    };
  }),
);
---

<BaseLayout>
  <section class="border-b border-[var(--color-ink-10)] bg-[var(--color-cream)]">
    <div class="container-grid py-16">
      <p class="text-eyebrow">
        Today's stack · {new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
      </p>
      <h1 class="mt-4 max-w-[18ch] font-sans text-[56px] font-bold leading-[0.95] tracking-[-0.036em] text-[var(--color-ink)]">
        Software we'd renew tomorrow<span class="text-[var(--color-blue)]">.</span>
      </h1>
      <p class="mt-6 max-w-[560px] font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
        Independent reviews of SaaS, AI tools, and software that operators and founders actually pay for. Editorial first, commerce second. Tested in production, not in a demo.
      </p>
      <a
        href="#newsletter"
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-[var(--color-blue)] px-6 py-3 font-sans text-[14px] font-semibold text-[var(--color-cream)] transition-transform duration-150 ease-out hover:-translate-y-[1px] motion-reduce:hover:translate-y-0"
      >
        Get the newsletter
      </a>
    </div>
  </section>

  {
    featured && featuredCategory && featuredAuthor ? (
      <section class="container-grid py-16">
        <a href={featuredHref} class="group block max-w-[720px]">
          <p class="text-eyebrow">Featured · {featured.data.eyebrow}</p>
          <h2 class="mt-3 font-serif text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-[var(--color-ink)] group-hover:opacity-85">
            {featured.data.title}
          </h2>
          <p class="mt-4 font-serif text-[17px] leading-[1.7] text-[var(--color-ink-85)]">
            {featured.data.answer ?? featured.data.description}
          </p>
          <p class="mt-5 font-sans text-[12px] text-[var(--color-ink-55)]">
            {authorByline(featuredAuthor.data)} {featured.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </p>
        </a>
      </section>
    ) : (
      <section class="container-grid py-16">
        <p class="max-w-[560px] font-serif italic text-[var(--color-ink-70)]">
          First reviews are in testing. Subscribe below and we will send them when they ship.
        </p>
      </section>
    )
  }

  {
    restRows.length > 0 && (
      <section class="container-grid pb-16">
        <h2 class="font-sans text-[28px] font-bold tracking-[-0.022em] text-[var(--color-ink)]">
          From the stack
        </h2>
        <ul class="mt-6">
          {restRows.map(({ article, href, byline }) => (
            <li class="border-t border-[var(--color-ink-10)]">
              <a href={href} class="flex min-h-11 flex-col gap-1 py-5">
                <p class="text-eyebrow">{article.data.eyebrow}</p>
                <h3 class="font-serif text-[22px] font-medium leading-[1.2] tracking-[-0.018em] text-[var(--color-ink)]">
                  {article.data.title}
                </h3>
                <p class="font-sans text-[12px] text-[var(--color-ink-55)]">
                  {byline}{' '}
                  {article.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="border-y border-[var(--color-ink-10)] bg-[var(--color-cream)] py-12">
    <div class="container-grid">
      <p class="text-eyebrow">Sections</p>
      <nav aria-label="Sections" class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
        {categories.map((c) => (
          <a
            href={`/${c.data.slug}/`}
            class="inline-flex min-h-11 items-center font-sans text-[16px] font-medium text-[var(--color-ink)] hover:opacity-70"
          >
            {c.data.name}
          </a>
        ))}
        <a
          href="/archive/"
          class="inline-flex min-h-11 items-center font-sans text-[16px] font-medium text-[var(--color-ink)] hover:opacity-70"
        >
          Archive
        </a>
      </nav>
    </div>
  </section>

  <section class="container-grid py-16">
    <NewsletterForm variant="card" source="home" />
  </section>
</BaseLayout>
