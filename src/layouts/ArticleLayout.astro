---
import { Image, getImage } from 'astro:assets';
import { getEntry, getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Disclosure from '~/components/ui/Disclosure.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
import ArticleCard from '~/components/ui/ArticleCard.astro';
import Stars from '~/components/ui/Stars.astro';
import { articleSchema, reviewSchema, faqSchema, breadcrumbSchema } from '~/lib/schema';
import { ogImage, SITE, canonical } from '~/lib/seo';
import { articleSlug, articleVisibility, isPublished } from '~/lib/publish';
import { authorByline } from '~/lib/byline';

type Props = {
  entry: CollectionEntry<'articles'>;
};

const { entry } = Astro.props;
const { data } = entry;

const category = await getEntry(data.category);
const author = await getEntry(data.author);
if (!category || !author) {
  throw new Error(`Missing category or author for article ${entry.id}`);
}

const slug = articleSlug(entry.id);
const articleUrl = canonical(`/${category.data.slug}/${slug}/`);
const heroPath = `${category.data.slug}/${slug}`;
const visibility = articleVisibility(data);
const noindex = visibility !== 'published';

const allArticles = await getCollection('articles', ({ data: item }) => isPublished(item) && item.type !== 'review');
const fallbackRelated = allArticles
  .filter((a) => a.id !== entry.id && a.data.category.id === data.category.id)
  .slice(0, 3);

const relatedEntries = data.related.length
  ? await Promise.all(data.related.map((ref) => getEntry(ref)))
  : fallbackRelated;
const related = relatedEntries.filter((r): r is CollectionEntry<'articles'> => Boolean(r) && isPublished(r.data));

const isReview = data.type === 'review';
const reviewedProduct = isReview && data.products[0] ? await getEntry(data.products[0]) : null;

const customOg = data.og
  ? await getImage({ src: data.og, width: 1200, height: 630, format: 'png' })
  : null;
const ogUrl = customOg?.src
  ? new URL(customOg.src, SITE.url).toString()
  : ogImage(heroPath);

const ld: object[] = [
  isReview && reviewedProduct
    ? reviewSchema({
        url: articleUrl,
        title: data.title,
        description: data.description,
        datePublished: data.date,
        dateModified: data.updated ?? undefined,
        authorName: author.data.name,
        image: ogUrl,
        productName: reviewedProduct.data.name,
        productCategory: category.data.name,
        rating: data.rating ?? reviewedProduct.data.rating,
      })
    : articleSchema({
        url: articleUrl,
        title: data.title,
        description: data.description,
        datePublished: data.date,
        dateModified: data.updated ?? undefined,
        authorName: author.data.name,
        image: ogUrl,
        section: category.data.name,
      }),
  breadcrumbSchema([
    { name: 'Home', url: SITE.url },
    { name: category.data.name, url: `${SITE.url}/${category.data.slug}/` },
    { name: data.title, url: articleUrl },
  ]),
];
const faq = faqSchema(data.faq);
if (faq) ld.push(faq);

const datePub = data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const dateUpd = data.updated?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title={data.title}
  description={data.description}
  ogSlug={heroPath}
  ogImageUrl={ogUrl}
  type="article"
  publishedTime={data.date.toISOString()}
  modifiedTime={data.updated?.toISOString()}
  authorName={author.data.name}
  jsonLd={ld}
  noindex={noindex}
>
  <article class="pb-16 pt-10">
    <div class="container-article">
      <nav aria-label="Breadcrumb" class="font-sans text-[12px] text-[var(--color-ink-55)]">
        <a href="/" class="inline-flex min-h-11 items-center hover:opacity-75 focus-visible:opacity-100">Home</a>
        <span aria-hidden="true"> · </span>
        <a href={`/${category.data.slug}/`} class="inline-flex min-h-11 items-center hover:opacity-75">
          {category.data.name}
        </a>
      </nav>

      <header class="mt-8">
        <p class="text-eyebrow">
          {data.eyebrow}
        </p>
        <h1
          class="mt-3 font-serif text-[42px] font-medium leading-[1.05] tracking-[-0.026em] text-[var(--color-ink)] sm:text-[52px]"
        >
          {data.title}
        </h1>
        {
          data.answer ? (
            <p class="mt-6 font-serif text-[17px] leading-[1.7] text-[var(--color-ink)]">
              {data.answer}
            </p>
          ) : (
            <p class="mt-5 font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
              {data.description}
            </p>
          )
        }

        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 font-sans text-[12px] text-[var(--color-ink-55)]">
          <span class="text-[var(--color-ink)]">{authorByline(author.data)}</span>
          <span>·</span>
          <time datetime={data.date.toISOString()}>{datePub}</time>
          {
            data.updated && (
              <>
                <span>·</span>
                <span>Updated <time datetime={data.updated.toISOString()}>{dateUpd}</time></span>
              </>
            )
          }
          {
            isReview && (data.rating ?? reviewedProduct?.data.rating) && (
              <>
                <span>·</span>
                <Stars rating={data.rating ?? reviewedProduct!.data.rating} />
              </>
            )
          }
        </div>
      </header>
    </div>

    {
      data.hero && (
        <figure class="mx-auto mt-10 max-w-[900px] px-6">
          <Image
            src={data.hero}
            alt={data.heroAlt ?? data.title}
            widths={[640, 960, 1280]}
            sizes="(min-width: 960px) 900px, 100vw"
            loading="eager"
            class="aspect-[16/9] w-full rounded-[var(--radius-xl)] object-cover"
          />
        </figure>
      )
    }

    <div class="container-article mt-12">
      {isReview && <Disclosure variant="banner" />}
      <div class="prose-ms">
        <slot />
      </div>

      {
        data.faq.length > 0 && (
          <section class="not-prose mt-16 border-t border-[var(--color-ink-10)] pt-10">
            <h2 class="font-serif text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-[var(--color-ink)]">
              Frequently asked
            </h2>
            <dl class="mt-6 space-y-6">
              {data.faq.map((faqEntry) => (
                <div>
                  <dt class="font-sans text-[16px] font-bold text-[var(--color-ink)]">{faqEntry.q}</dt>
                  <dd class="mt-2 font-serif text-[17px] leading-[1.7] text-[var(--color-ink-85)]">
                    {faqEntry.a}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        data.sources.length > 0 && (
          <section class="not-prose mt-16 border-t border-[var(--color-ink-10)] pt-10">
            <h2 class="font-serif text-[28px] font-medium leading-[1.15] tracking-[-0.02em] text-[var(--color-ink)]">
              Sources
            </h2>
            <ul class="mt-6 space-y-3 font-serif text-[17px] leading-[1.7] text-[var(--color-ink-85)]">
              {data.sources.map((source) => (
                <li>
                  {source.url ? (
                    <a href={source.url} class="underline underline-offset-2">
                      {source.title}
                    </a>
                  ) : (
                    source.title
                  )}
                  <span class="font-sans text-[13px] text-[var(--color-ink-55)]">
                    {' '}
                    Checked {source.checked.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <div class="container-article mt-16">
      <NewsletterForm variant="card" source={`article-${slug}`} />
    </div>

    {
      related.length > 0 && (
        <section class="container-grid mt-20">
          <h2 class="font-sans text-[20px] font-bold uppercase tracking-[0.04em] text-[var(--color-ink-55)]">
            Read next
          </h2>
          <div class="mt-6 grid grid-cols-1 gap-10 md:grid-cols-3">
            {related.slice(0, 3).map((r) => (
              <ArticleCard article={r} size="sm" />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
