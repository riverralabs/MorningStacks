---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  src: ImageMetadata;
  alt: string;
  caption?: string;
};

const { src, alt, caption = alt } = Astro.props;
---

<figure class="not-prose my-10">
  <Image
    src={src}
    alt={alt}
    widths={[720, 960, 1200, 1600]}
    sizes="(min-width: 720px) 720px, 100vw"
    class="h-auto w-full"
  />
  <figcaption class="mt-3 font-sans text-[12px] leading-snug text-[var(--color-ink-55)]">
    {caption}
  </figcaption>
</figure>
