---
import Wordmark from './Wordmark.astro';
import Button from '~/components/ui/Button.astro';
import Icon from '~/components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order,
);

const navItems = [
  ...categories.map((c) => ({ href: `/${c.data.slug}/`, label: c.data.name })),
  { href: '/archive/', label: 'Archive' },
  { href: '/about/', label: 'About' },
];
---

<header class="border-b border-[var(--color-ink-10)] bg-[var(--color-cream)]">
  <div class="container-grid flex items-center justify-between gap-6 py-4">
    <Wordmark size="md" />

    <nav
      aria-label="Primary"
      class="hidden md:flex items-center gap-7 font-sans text-[14px] font-medium text-[var(--color-ink-85)]"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-11 items-center transition-opacity duration-150 hover:opacity-65"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <Button href="/search/" variant="icon" ariaLabel="Search">
        <Icon name="search" />
      </Button>
      <span class="hidden sm:inline-flex">
        <Button href="/#newsletter" arrow>
          Subscribe
        </Button>
      </span>

      <details class="group relative md:hidden">
        <summary
          class="flex size-11 min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-md border border-[var(--color-ink-15)] text-[var(--color-ink)] transition-colors hover:border-[var(--color-blue)] hover:text-[var(--color-blue)] [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menu</span>
          <Icon name="menu" class="group-open:hidden" />
          <Icon name="close" class="hidden group-open:block" />
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute right-0 z-20 mt-2 w-56 rounded-[var(--radius-lg)] border border-[var(--color-ink-10)] bg-[var(--color-cream)] p-2"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="flex min-h-11 items-center rounded-md px-3 font-sans text-[14px] font-medium text-[var(--color-ink-85)] hover:bg-[var(--color-cream-warm)]"
              >
                {item.label}
              </a>
            ))
          }
          <Button href="/#newsletter" class="mt-1 w-full" arrow>
            Subscribe
          </Button>
        </nav>
      </details>
    </div>
  </div>
</header>
