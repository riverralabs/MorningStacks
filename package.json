{
  "name": "morningstacks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build && pagefind --site .next/server/app --output-path .next/static/pagefind",
    "preview": "next start",
    "lint": "eslint . --ext .js,.ts,.tsx,.mjs,.cjs",
    "typecheck": "tsc --noEmit",
    "check:content": "node --experimental-strip-types scripts/check-publish-gates.mjs",
    "check:sitemap": "node --experimental-strip-types scripts/check-sitemap.mjs",
    "test:content": "node --experimental-strip-types --test scripts/check-publish-gates.test.mjs scripts/affiliate.test.mjs scripts/newsletter.test.mjs",
    "test:seo": "node --experimental-strip-types --test scripts/seo.test.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@keystatic/core": "^0.6.9",
    "@keystatic/next": "5.0.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "15.5.26",
    "next-mdx-remote": "^6.0.0",
    "pagefind": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "satori": "^0.13.2",
    "satori-html": "^0.3.2",
    "schema-dts": "^1.1.5",
    "server-only": "^0.0.1",
    "sharp": "^0.34.1",
    "tailwindcss": "^4.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.15.17",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.26.0",
    "globals": "^17.6.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@resvg/resvg-js"
    ]
  }
}
