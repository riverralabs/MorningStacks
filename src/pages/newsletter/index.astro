---
import BaseLayout from '~/layouts/BaseLayout.astro';
import NewsletterForm from '~/components/ui/NewsletterForm.astro';
---

<BaseLayout
  title="The MorningStacks newsletter"
  description="One short email every Monday morning. The tools we tested last week, what stood up, what fell apart. Free, no spam, unsubscribe anytime."
  ogSlug="newsletter"
>
  <section class="container-grid py-20">
    <p class="text-eyebrow">
      The newsletter
    </p>
    <h1 class="mt-3 font-sans text-[56px] font-bold leading-[0.95] tracking-[-0.036em] text-[var(--color-ink)]">
      Monday morning,<br />in your inbox<span class="text-[var(--color-blue)]">.</span>
    </h1>
    <p class="mt-6 max-w-[640px] font-serif text-[20px] italic leading-relaxed text-[var(--color-ink-70)]">
      The tools we tested last week, what stood up, what fell apart. Five-minute read. Operator-grade. No fluff.
    </p>

    <div class="mt-12 max-w-[640px]">
      <NewsletterForm variant="card" source="newsletter-page" heading="Subscribe" blurb="One email a week. Curated, not aggregated. Unsubscribe with one click." />
    </div>

    <div class="mt-20 max-w-[720px]">
      <h2 class="font-sans text-[24px] font-bold tracking-[-0.018em] text-[var(--color-ink)]">
        Past issues
      </h2>
      <p class="mt-3 font-serif italic text-[var(--color-ink-70)]">
        Coming soon. We'll archive each issue here a week after sending.
      </p>
    </div>
  </section>
</BaseLayout>
