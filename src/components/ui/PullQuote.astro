---
type Props = {
  cite?: string;
};

const { cite } = Astro.props;
---

<figure
  class="not-prose my-12 border-l-[3px] border-[var(--color-blue)] py-2 pl-8"
>
  <blockquote
    class="m-0 font-serif text-[24px] italic leading-snug text-[var(--color-ink-85)]"
  >
    <slot />
  </blockquote>
  {
    cite && (
      <figcaption class="mt-3 font-sans text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--color-ink-55)]">
        {cite}
      </figcaption>
    )
  }
</figure>
